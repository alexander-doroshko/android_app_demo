module(
    name = "android_app_demo",
    version = "0.1",
)

bazel_dep(name = "rules_android", version = "0.6.0")
bazel_dep(name = "rules_kotlin", version = "2.1.0")
bazel_dep(name = "rules_jvm_external", version = "6.4")

# Android SDK configuration
android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk_repository_extension, "androidsdk")

# Maven dependencies
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        # AndroidX core
        "androidx.appcompat:appcompat:1.7.0",
        "androidx.core:core-ktx:1.13.1",
        "androidx.constraintlayout:constraintlayout:2.1.4",
        "androidx.cardview:cardview:1.0.0",
        "com.google.android.material:material:1.12.0",
        "androidx.activity:activity-compose:1.9.2",

        # Lifecycle
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.8.6",
        "androidx.lifecycle:lifecycle-runtime-ktx:2.8.6",
        "androidx.lifecycle:lifecycle-viewmodel-compose:2.8.6",

        # Jetpack Compose
        "androidx.compose.ui:ui:1.7.4",
        "androidx.compose.ui:ui-tooling:1.7.4",
        "androidx.compose.ui:ui-tooling-preview:1.7.4",
        "androidx.compose.material3:material3:1.3.0",
        "androidx.compose.foundation:foundation:1.7.4",
        "androidx.compose.runtime:runtime:1.7.4",
        "androidx.compose.runtime:runtime-livedata:1.7.4",
        "androidx.lifecycle:lifecycle-livedata-ktx:2.8.6",

        # Networking
        "com.squareup.okhttp3:okhttp:4.12.0",
        "com.squareup.okhttp3:logging-interceptor:4.12.0",
        "com.squareup.retrofit2:retrofit:2.11.0",
        "com.squareup.retrofit2:converter-gson:2.11.0",

        # Testing
        "junit:junit:4.13.2",
        "org.robolectric:robolectric:4.13",
        "org.mockito:mockito-core:5.4.0",
        "org.mockito.kotlin:mockito-kotlin:5.4.0",
        "androidx.test:core:1.6.1",
        "androidx.test:runner:1.6.1",
        "androidx.test.ext:junit:1.2.1",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.8.1",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")
