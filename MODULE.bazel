module(
    name = "android_app_demo",
    version = "0.1",
)

bazel_dep(name = "rules_android", version = "0.7.3")
bazel_dep(name = "rules_kotlin", version = "2.4.20")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "6.9")

# Android SDK configuration
android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk_repository_extension, "androidsdk")

# Maven dependencies
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        # Pinned transitive deps to resolve coursier exact-range conflicts ([x.y.z])
        # collection: Compose 1.7.4 needs collection-jvm:1.4.4; pin all sub-artifacts to match
        "androidx.collection:collection:1.4.4",
        "androidx.collection:collection-ktx:1.4.4",
        "androidx.collection:collection-jvm:1.4.4",
        # emoji2: pin to avoid [1.2.0] exact constraint from views-helper
        "androidx.emoji2:emoji2:1.3.0",
        "androidx.emoji2:emoji2-views-helper:1.3.0",
        # lifecycle: pin all sub-artifacts at 2.8.6 to avoid multi-version exact constraints
        "androidx.lifecycle:lifecycle-common:2.8.6",
        "androidx.lifecycle:lifecycle-common-java8:2.8.6",
        "androidx.lifecycle:lifecycle-livedata-core:2.8.6",
        "androidx.lifecycle:lifecycle-viewmodel:2.8.6",
        "androidx.lifecycle:lifecycle-runtime:2.8.6",
        # activity + fragment: upgrade to avoid old lifecycle transitive deps
        "androidx.activity:activity:1.9.2",
        "androidx.activity:activity-ktx:1.9.2",
        "androidx.fragment:fragment:1.8.4",
        "androidx.fragment:fragment-ktx:1.8.4",

        # concurrent-futures + listenablefuture: pulled transitively by profileinstaller
        # (via activity-compose). The 9999.0-empty stub must be replaced with a real impl.
        "androidx.concurrent:concurrent-futures:1.1.0",
        "com.google.guava:listenablefuture:1.0",

        # AndroidX core
        "androidx.appcompat:appcompat:1.7.0",
        "androidx.core:core-ktx:1.13.1",
        "androidx.constraintlayout:constraintlayout:2.1.4",
        "androidx.cardview:cardview:1.0.0",
        "com.google.android.material:material:1.12.0",
        "androidx.activity:activity-compose:1.9.2",

        # Lifecycle
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.8.6",
        "androidx.lifecycle:lifecycle-runtime-ktx:2.8.6",
        "androidx.lifecycle:lifecycle-livedata-ktx:2.8.6",

        # Jetpack Compose
        "androidx.compose.ui:ui:1.7.4",
        "androidx.compose.ui:ui-tooling:1.7.4",
        "androidx.compose.ui:ui-tooling-preview:1.7.4",
        # Pin material + material-ripple: ui-tooling pulls material:1.0.0 which has
        # an exact-range constraint [1.0.0] on material-ripple; pin both to current versions.
        "androidx.compose.material:material:1.7.4",
        "androidx.compose.material:material-ripple:1.7.0",
        "androidx.compose.material3:material3:1.3.0",
        "androidx.compose.foundation:foundation:1.7.4",
        "androidx.compose.runtime:runtime:1.7.4",
        "androidx.compose.runtime:runtime-livedata:1.7.4",

        # Networking
        "com.squareup.okhttp3:okhttp:4.12.0",
        "com.squareup.okhttp3:logging-interceptor:4.12.0",
        "com.squareup.retrofit2:retrofit:2.11.0",
        "com.squareup.retrofit2:converter-gson:2.11.0",

        # Testing
        "junit:junit:4.13.2",
        "org.robolectric:robolectric:4.14.1",
        "org.mockito:mockito-core:5.4.0",
        "org.mockito.kotlin:mockito-kotlin:5.4.0",
        "androidx.test:core:1.6.1",
        "androidx.test:runner:1.6.1",
        "androidx.test.ext:junit:1.2.1",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.8.1",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    version_conflict_policy = "pinned",
    known_contributing_modules = ["android_app_demo", "protobuf"],
    use_starlark_android_rules = True,
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
)
use_repo(maven, "maven")
