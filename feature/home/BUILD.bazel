    srcs = glob(["java/**/*.kt"]),
    custom_package = "com.example.feature.home",
    manifest = "AndroidManifest.xml",
    resource_files = glob(["res/**"]),
    visibility = ["//visibility:public"],
    deps = [
        "//core/base:base_kt",
        "//core/resources",
        "//domain/usecase",
        "//domain/model",
        "//ui/components",
