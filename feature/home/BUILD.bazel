android_local_test(
    name = "HomeViewModelTest",
    srcs = glob(["test/**/*.kt"]),
    manifest = "AndroidManifest.xml",
    test_class = "com.example.feature.home.HomeViewModelTest",
    deps = [
        ":home",
        "//domain/model",
        "//domain/usecase",
        "@maven//:junit_junit",
        "@maven//:org_mockito_kotlin_mockito_kotlin",
        "@maven//:org_robolectric_robolectric",
        "@maven//:androidx_test_core",
