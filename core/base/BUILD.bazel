load("@rules_android//rules:rules.bzl", "android_library")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

# Java base classes (AppCompat-based, references maven R resources)
android_library(
    name = "base_java",
    srcs = ["java/com/example/core/base/BaseActivity.java"],
    custom_package = "com.example.core.base",
    manifest = "AndroidManifest.xml",
    resource_files = glob(["res/**"]),
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:androidx_appcompat_appcompat",
        "@maven//:androidx_core_core_ktx",
    ],
)

# Kotlin ViewModel base
kt_android_library(
    name = "base_kt",
    srcs = ["java/com/example/core/base/BaseViewModel.kt"],
    custom_package = "com.example.core.base",
    manifest = "AndroidManifest.xml",
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:androidx_lifecycle_lifecycle_viewmodel_ktx",
        "@maven//:androidx_lifecycle_lifecycle_runtime_ktx",
    ],
)

# Convenience target
alias(
    name = "base",
    actual = ":base_java",
    visibility = ["//visibility:public"],
)
