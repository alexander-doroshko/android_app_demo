load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

kt_android_library(
    name = "app_lib",
    srcs = glob(["java/**/*.kt"]),
    custom_package = "com.example.app",
    manifest = "AndroidManifest.xml",
    plugins = ["//tools:compose_compiler_plugin"],
    resource_files = glob(["res/**"]),
    visibility = ["//visibility:public"],
    deps = [
        # MainActivity.kt directly imports these — must be direct deps
        "//feature/home",
        "//feature/profile:profile_java",  # for ProfileActivity class reference
        "//feature/settings",  # for SettingsActivity class reference
        "//ui/theme",
        # Runtime resources needed for the binary
        "//core/resources",
        "@maven//:androidx_activity_activity_compose",
        "@maven//:androidx_appcompat_appcompat",
        "@maven//:androidx_compose_material3_material3",
        "@maven//:androidx_compose_runtime_runtime",
        "@maven//:androidx_compose_ui_ui",
        "@maven//:com_google_android_material_material",
    ],
)

android_binary(
    name = "app",
    custom_package = "com.example.app",
    manifest = "AndroidManifest.xml",
    manifest_values = {
        "minSdkVersion": "26",
        "targetSdkVersion": "34",
        "versionCode": "1",
        "versionName": "1.0",
    },
    visibility = ["//visibility:public"],
    deps = [
        ":app_lib",
    ],
)
